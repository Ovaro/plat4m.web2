<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="codex" id="20260721000100-1">
        <createTable tableName="dashboard_panel_definition">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="dashboard_panel_definition_pk"/>
            </column>
            <column name="scope" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="panel_type" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="config_json" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="bigint"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="dashboard_panel_definition"
            baseColumnNames="user_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"
            constraintName="fk_dashboard_panel_definition_user_id"/>

        <createIndex indexName="idx_dashboard_panel_definition_scope" tableName="dashboard_panel_definition">
            <column name="scope"/>
        </createIndex>

        <createIndex indexName="idx_dashboard_panel_definition_user_id" tableName="dashboard_panel_definition">
            <column name="user_id"/>
        </createIndex>

        <createTable tableName="user_dashboard_config">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="user_dashboard_config_pk"/>
            </column>
            <column name="name" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="layout_json" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="user_dashboard_config"
            baseColumnNames="user_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"
            constraintName="fk_user_dashboard_config_user_id"/>

        <createIndex indexName="idx_user_dashboard_config_user_active" tableName="user_dashboard_config">
            <column name="user_id"/>
            <column name="active"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
